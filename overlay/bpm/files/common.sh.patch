diff --git a/lib/common.sh b/lib/common.sh
index 1c9363d..2abdaf1 100644
--- a/lib/common.sh
+++ b/lib/common.sh
@@ -391,11 +391,25 @@ fetch_git() {
 
 src_fetch() {
     mkdir -p "$src_dir"
+    _n=0
+    set -- ${checksum:-}
     for _d in ${dist_files:-}; do
+        _n=$((_n + 1))
         _f=$src_dir/$(dist_name "$_d")
         case $_d in
             git+*) fetch_git "$_d" "$_f" ;;
-            *) if [ ! -f "$_f" ]; then fetch_url "${_d%%>*}" "$_f"; fi ;;
+            *)
+                # a restored cache can hold bytes fetched under an older
+                # checksum (upstream re-hashed a mirror): never trust a
+                # pre-existing file, refetch it if it no longer verifies
+                eval "_want=\${$_n:-}"
+                if [ -n "$_want" ] && [ "$_want" != SKIP ] && [ -f "$_f" ] && \
+                   ! src_check "$_f" "$_want"; then
+                    warn "cached source fails checksum, re-fetching ${_f##*/}"
+                    rm -f "$_f"
+                fi
+                [ -f "$_f" ] || fetch_url "${_d%%>*}" "$_f"
+                ;;
         esac
     done
 }
@@ -406,6 +420,17 @@ blake3() {
     else die "no blake3 implementation found (install b3sum or rhash)"; fi
 }
 
+# 0 = file matches the expected hash, 1 = mismatch or missing
+src_check() {
+    _f=$1 _want=$2
+    [ -f "$_f" ] || return 1
+    _got=$(blake3 "$_f")
+    _cmp=${#_want}
+    if [ "${#_got}" -lt "$_cmp" ]; then _cmp=${#_got}; fi
+    [ "$(printf '%s' "$_want" | cut -c"1-$_cmp")" = \
+      "$(printf '%s' "$_got"  | cut -c"1-$_cmp")" ]
+}
+
 src_verify() {
     _n=0
     set -- ${checksum:-}
@@ -416,14 +441,10 @@ src_verify() {
         eval "_want=\${$_n:-}"
         [ -n "$_want" ] || die "$pkg_name: missing checksum for ${_f##*/}"
         case $_want in SKIP) continue ;; esac
-        _got=$(blake3 "$_f")
-        _cmp=${#_want}
-        if [ "${#_got}" -lt "$_cmp" ]; then _cmp=${#_got}; fi
-        if [ "$(printf '%s' "$_want" | cut -c"1-$_cmp")" != \
-             "$(printf '%s' "$_got"  | cut -c"1-$_cmp")" ]; then
+        if ! src_check "$_f" "$_want"; then
             die "$pkg_name: blake3 mismatch for ${_f##*/}
     expected $_want
-    got      $_got"
+    got      $(blake3 "$_f")"
         fi
     done
 }
