pkg_name=musl
version=1.2.6
revision=1
build_style=configure
short_desc="musl libc"
home_page="https://musl.libc.org"
license="MIT"
dist_files="https://github.com/ifduyue/musl/archive/refs/tags/v1.2.6.tar.gz"
checksum="6d1693237e919e2f1827a0108ef4330340230329a1c4ac2cf3d42dbfdd839a9f"
configure_args="--syslibdir=/usr/lib"

post_install() {
    # ldd is a symlink to the dynamic linker
    bln /usr/lib/ld-musl-x86_64.so.1 /usr/bin/ldd
    # upstreams own symlink points at the wrong name
    bln libc.so /usr/lib/ld-musl-x86_64.so.1

    for h in cdefs.h queue.h tree.h; do
        binstall "$FILESDIR/$h" 0644 /usr/include/sys
    done

    $CC "$FILESDIR/getconf.c" -o getconf && bbin getconf
    $CC "$FILESDIR/getent.c" -o getent  && bbin getent

    blicense COPYRIGHT
}
