pkg_name=pigz
version=2.8
revision=1
build_style=custom
short_desc="Parallel gzip"
home_page="https://zlib.net/pigz/"
license="Zlib"
dist_files="https://codeload.github.com/madler/pigz/tar.gz/refs/tags/v2.8"
checksum="1ab441fbc983a7442d11b4842a6bddfb5376b6940fe2ba735de0f22161e0d802"
depends="zlib"
make_depends="zlib"

do_build() {
    for f in pigz yarn try; do
        $CC -c -o "$f.o" "$f.c" ${CPPFLAGS:-} -DNOZOPFLI $CFLAGS
    done
    $CC -static -o pigz pigz.o yarn.o try.o ${CPPFLAGS:-} $CFLAGS -lz $LDFLAGS
}

do_install() {
    bbin pigz
    bman pigz.1
    bln pigz /usr/bin/gzip
    bln pigz.1 /usr/share/man/man1/gzip.1
}
